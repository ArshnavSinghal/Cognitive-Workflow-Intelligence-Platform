# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cwip_db

# JWT signing secret — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret

# Data mode: 'development' marks outcomes as test data (default)
#             'real'        marks outcomes as genuine learner data
CWIP_DATA_MODE=development
